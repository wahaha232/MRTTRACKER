# ============================================================
# METRO QUEST — Live Mode 設定
# 複製本檔案為 .env 並填入你的臺北捷運官方 API 資料後，
# 重新執行 npm run dev / npm run build。
# 切勿把真正的 API Secret 提交到 Git repository。
# ============================================================

# 臺北捷運官方 Open Data API 基礎 URL（Live Mode 才需要）
VITE_METRO_API_BASE_URL=

# 臺北捷運官方 API 金鑰（申請制，Live Mode 才需要）
VITE_METRO_API_KEY=

# 資料更新頻率（秒）：5 | 10 | 15 | 30 | 60，預設 10
VITE_METRO_UPDATE_INTERVAL=10
