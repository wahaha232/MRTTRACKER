# ============================================================
# METRO QUEST — Live Mode 設定
# 複製本檔案為 .env 並填入設定後，重新執行 npm run dev / npm run build。
# 切勿把真正的 API Secret 提交到 Git repository。
#
# Live Mode 資料來源是 TDX（交通部運輸資料流通服務平台）的台北捷運
# 「車站電子看板」（LiveBoard），不是列車即時 GPS 位置，因此地圖上不會有
# 移動的列車圖示，改為點擊車站顯示到站看板。
#
# 因為本 repo 部署在 GitHub Pages（純靜態，沒有後端），TDX 的 Client ID /
# Client Secret 不能放進這個前端專案，一律設定在 cloudflare-worker/ 這支
# 獨立的 Cloudflare Worker 裡（見該目錄 worker.js 開頭的部署說明）。
# ============================================================

# 已部署好的 Cloudflare Worker 網址（Live Mode 才需要，瀏覽器可公開存取，
# 本身不含任何機密資訊）。例如：
#   https://mrttracker-tdx-proxy.<你的-subdomain>.workers.dev
# 留空時 Live Mode 視為未設定，網站會自動維持在 Demo Mode。
VITE_METRO_API_BASE_URL=

# 資料更新頻率（秒）：5 | 10 | 15 | 30 | 60，預設 10
VITE_METRO_UPDATE_INTERVAL=10

# ============================================================
# Google AdSense 廣告（選用）
# 預設 VITE_ADS_ENABLED 未設為 true 時，網站會顯示
# 「AD · 廣告位置保留」的 8-bit 占位方塊（不會載入任何廣告）。
#
# 想正式投放廣告時：
#   1. 於 Google AdSense 後台建立「廣告單元」，取得 slot id
#   2. 將下方設定填入 .env
#   3. 重新執行 npm run dev / npm run build
# ============================================================

# 主開關：true 開啟真實 AdSense 廣告；留空或 false 顯示占位方塊
VITE_ADS_ENABLED=false

# AdSense 發布商 ID（格式 ca-pub-XXXXXXXXXXXXXXXX）
VITE_ADS_CLIENT=

# 各廣告位 slot ID（數字字串，於 AdSense 後台取得）
VITE_ADS_SLOT_RECT=    # 桌面：右側欄 300×250 矩形
VITE_ADS_SLOT_BANNER=  # 平板/手機：底部響應式橫幅
