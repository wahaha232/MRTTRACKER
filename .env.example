# ============================================================
# METRO QUEST — Live Mode 設定
# 複製本檔案為 .env 並填入你的臺北捷運官方 API 資料後，
# 重新執行 npm run dev / npm run build。
# 切勿把真正的 API Secret 提交到 Git repository。
# ============================================================

# 官方 API 的「非機密」proxy 端點（Live Mode 才需要，瀏覽器可公開存取）。
#   - 本變數使用 VITE_ 前綴，會被打包進公開的前端 bundle，因此這裡只能放
#     不含機密資訊的 proxy 路徑，例如同源路徑 "/metro" 或你自己架設的
#     proxy 端點（nginx / Cloudflare Worker / Lambda@Edge 等）。
#   - 真正的官方 API 金鑰不放這裡（見下方 METRO_API_KEY）。
#   - 留空時預設為同源路徑 "/metro"（由伺服器端 proxy 掛載）。
VITE_METRO_API_BASE_URL=

# 臺北捷運官方 API 金鑰（申請制，Live Mode 才需要）
# ⚠️ 資安注意：
#   - 請勿以 VITE_ 開頭命名，否則 Vite 會把它打包進公開的 JS bundle。
#   - 此金鑰只在「伺服器端 proxy/Edge server」上設定並用來轉發請求，
#     瀏覽器端程式碼一律不讀取、不發送它。
#   - 本 repo 部署到 GitHub Pages（純靜態），無法直接放 proxy；請在上方
#     VITE_METRO_API_BASE_URL 指向的 proxy 服務上設定此金鑰。
METRO_API_KEY=

# 資料更新頻率（秒）：5 | 10 | 15 | 30 | 60，預設 10
VITE_METRO_UPDATE_INTERVAL=10

# ============================================================
# Google AdSense 廣告（選用）
# 預設 VITE_ADS_ENABLED 未設為 true 時，網站會顯示
# 「AD · 廣告位置保留」的 8-bit 占位方塊（不會載入任何廣告）。
#
# 想正式投放廣告時：
#   1. 於 Google AdSense 後台建立「廣告單元」，取得 slot id
#   2. 將下方設定填入 .env
#   3. 重新執行 npm run dev / npm run build
# ============================================================

# 主開關：true 開啟真實 AdSense 廣告；留空或 false 顯示占位方塊
VITE_ADS_ENABLED=false

# AdSense 發布商 ID（格式 ca-pub-XXXXXXXXXXXXXXXX）
VITE_ADS_CLIENT=

# 各廣告位 slot ID（數字字串，於 AdSense 後台取得）
VITE_ADS_SLOT_RECT=    # 桌面：右側欄 300×250 矩形
VITE_ADS_SLOT_BANNER=  # 平板/手機：底部響應式橫幅
